# Copy to .env (git-ignored). Read by `task site:deploy`.
# Token: Cloudflare -> My Profile -> API Tokens -> Account > Workers Scripts > Edit
# (and Zone > Workers Routes > Edit on the zone of SITE_HOST).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# The public hostname, bare (no scheme, no slash). Unset = deploy on workers.dev only.
# The build derives SITE_URL (canonical, og:url, og:image) from it.
SITE_HOST=rsk.ralva.dev
