# Copy to .env (git-ignored). Read by `task site:deploy`.
# Token: Cloudflare -> My Profile -> API Tokens -> Create Token, from the "Edit Cloudflare Workers"
# template (or custom: Account > Workers Scripts/Editor > Edit, Zone > Workers Routes > Edit,
# Zone > DNS > Edit), with Zone Resources restricted to the zone of SITE_HOST. Put it, and the
# account id (dashboard > account overview), in .env. One token can serve every site of that zone.
# The token is a secret kept as a file outside the repo (mode 0600), by reference:
CLOUDFLARE_API_TOKEN_FILE=~/Secrets/cloudflare/workers/<token-file>
# (or CLOUDFLARE_API_TOKEN=<the token> directly; it wins when both are set)
CLOUDFLARE_ACCOUNT_ID=
# The public hostname, bare (no scheme, no slash). Unset = deploy on workers.dev only.
# The build derives SITE_URL (canonical, og:url, og:image) from it.
SITE_HOST=rsk.ralva.dev

# Host of the skills registry the page names (bare hostname). Required: the build fails without it.
VITE_REGISTRY_HOST=skills.ralva.dev
