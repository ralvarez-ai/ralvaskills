// Cloudflare Workers static assets: no Worker code, `dist/` is served as it is.
// The hostname is NOT here: it is SITE_HOST in site/.env (see scripts/deploy.mjs),
// so it can change without a code edit. Deploy with `task site:deploy`.
// `_headers` in dist/ is applied by the platform. Static requests are free.
{
  "name": "ralvaskills",
  "compatibility_date": "2026-11-06",
  "assets": { "directory": "./dist" },
}
