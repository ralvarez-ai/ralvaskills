// Cloudflare Workers static assets: `dist/` is served as it is. The Worker (worker/index.js)
// runs first only for /registry/*, where it proxies the registry index (see its header).
// The hostname is NOT here: it is SITE_HOST in site/.env (see scripts/deploy.mjs),
// so it can change without a code edit. The registry origin is REGISTRY_HOST the same way. Deploy with `task site:deploy`.
// `_headers` in dist/ is applied by the platform. Static requests are free.
{
  "name": "ralvaskills",
  "compatibility_date": "2026-11-06",
  "main": "./worker/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/registry/*"] },
}
